<% title_tag @page_title || t("menu.products") %>
<%= render "topics/node_info", node: nil %>

<div class="row">
  <div class="col-lg-9">
    <div class="products-board">
      <% if @this_week_products.present? %>
        <div class="products-section">
          <h2 class="products-section-title"><%= t("products.this_week") %> · <%= @this_week_products.size %></h2>
          <div class="product-grid">
            <%= render ProductComponent.with_collection(@this_week_products) %>
          </div>
        </div>
      <% end %>

      <div class="products-section">
        <h2 class="products-section-title"><%= t("products.earlier") %></h2>
        <% if @earlier_products.present? %>
          <div class="product-grid">
            <%= render ProductComponent.with_collection(@earlier_products) %>
          </div>
        <% else %>
          <div class="card">
            <div class="card-body text-center text-muted"><%= t("products.empty") %></div>
          </div>
        <% end %>
        <% if @earlier_products.respond_to?(:total_pages) && @earlier_products.total_pages > 1 %>
          <div class="card-footer clearfix">
            <%= paginate @earlier_products %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="sidebar col-lg-3">
    <%= render "topics/sidebar_for_topic_index" %>
    <div class="card sidebar-tips">
      <div class="card-header"><%= t("products.how_to_launch") %></div>
      <div class="card-body">
        <ol class="product-launch-steps">
          <li><%= t("products.how_to_launch_step1") %></li>
          <li><%= t("products.how_to_launch_step2") %></li>
          <li><%= t("products.how_to_launch_step3") %></li>
        </ol>
      </div>
    </div>
  </div>
</div>
