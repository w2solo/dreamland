<% title_tag t('topics.new_topic') %>
<div class="card card-lg">
  <div class="card-body">
    <% if @intent.blank? && @topic.node_id.blank? %>
      <%= render "intent_picker" %>
    <% else %>
      <div class="card-title hide-ios">
        <%= t('topics.new_topic') %>
      </div>
      <p class="topic-form-hint hide-ios">
        <%= t("topics.intent.go_launch_html", url: new_product_path) %>
      </p>
      <%= render 'form' %>
    <% end %>
  </div>
</div>
