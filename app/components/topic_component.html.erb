<% cache([topic, topic.user_avatar_raw, type]) do %>
  <article class="topic crayons-story topic-<%= topic.id %>" data-prefetch="<%= main_app.topic_path(topic) %>">
    <div class="story-meta">
      <div class="avatar">
        <%= user_avatar_tag(topic.user, :md) %>
      </div>
      <div class="story-byline">
        <%= user_name_tag(topic.user) %>
        <span class="story-date hidden-mobile">
          <% if topic.last_reply_user_login.blank? %>
            <%= raw t("common.created_at", time: timeago(topic.created_at))%>
          <% else %>
            <%= t("common.last_by")%> <%= user_name_tag(topic.last_reply_user_login) %> <%= raw t("common.reply_at", time: timeago(topic.replied_at))%>
          <% end %>
        </span>
      </div>
    </div>
    <h3 class="title media-heading">
      <%= link_to(main_app.topic_path(topic), title: topic.title) do %>
        <%= topic.title %>
      <% end %>
      <%= icon_tag("pin") if type == "suggest" %>
      <%= topic_excellent_tag(topic) %>
      <%= topic_close_tag(topic) %>
    </h3>
    <div class="story-tags">
      <% if topic.node&.name.present? %>
        <%= link_to main_app.node_topics_path(topic.node_id), class: "crayons-tag", data: { node: topic.node.name } do %>
          <span class="crayons-tag-prefix">#</span><%= topic.node.name %>
        <% end %>
      <% end %>
    </div>
    <div class="story-engagement">
      <span class="story-stat">
        <i class="fa fa-heart"></i>
        <%= topic.likes_count %>
      </span>
      <%= link_to("#{main_app.topic_path(topic)}#replies", class: "story-stat #{'state-false' if topic.replies_count > 0}") do %>
        <i class="fa fa-comment"></i>
        <%= topic.replies_count %> <%= t("common.comments") %>
      <% end %>
    </div>
  </article>
<% end %>
